# Copy to fastlane/.env.local and fill in. .env.local is gitignored by the root
# .gitignore rule `fastlane/.env.local` -- never commit the real file, and never
# put a secret in this example. (Copied from Tool Approvals: Hermes Glasses
# uses the same ASC key, match repo and signing keychain.)
#
# The Fastfile loads this file itself, for every lane -- fastlane's own dotenv
# support does not: it reads .env and .env.default, and .env.<name> only under
# `--env <name>`. So no `--env local` and no `set -a; . ...` preamble is needed,
# but the loading is the Fastfile's (see `adopt_env_file`), not fastlane's.
#
# ON MBP-M2 THIS FILE IS NOT NEEDED. Every value below already lives outside the
# repository, and the Fastfile reads it from there for any name the environment
# does not already have:
#
#   ~/Development/.env/approvals-fastlane   ASC_KEY_ID, ASC_ISSUER_ID,
#                                           ASC_KEY_PATH, MATCH_PASSWORD,
#                                           MATCH_GIT_BASIC_AUTHORIZATION
#   ~/Development/.env/approvals-keychain   MATCH_KEYCHAIN_NAME,
#                                           MATCH_KEYCHAIN_PASSWORD
#
# Both are mode 600 and are never read by anything that prints values. Use
# .env.local only on another machine, or to override one of them for a single
# run.

# --- App Store Connect API key (Eric creates this in App Store Connect) -----
# Users and Access -> Integrations -> App Store Connect API -> generate a key
# with the App Manager or Admin role. Download the .p8 ONCE and store it at
# mode 600 under ~/.appstoreconnect/private_keys/ (that directory already exists
# on mbp-m2, created by the macsetup lane).
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8

# --- fastlane match ---------------------------------------------------------
# The passphrase for the aapi-match-certs repository. On mbp-m2 it is in
# ~/Development/.env/approvals-fastlane (it was originally the GitHub Actions
# secret FASTLANE_MATCH_PASSWORD on ejlevin1/copilot-agent-oidc).
MATCH_PASSWORD=
# A token that can clone the private certs repo, base64 of "user:token".
MATCH_GIT_BASIC_AUTHORIZATION=

# --- The dedicated codesigning keychain -------------------------------------
# Required for headless/SSH runs on mbp-m2. The login keychain is locked over
# SSH and holds a *copy* of the same Apple Distribution certificate; being
# earlier in the search list it wins identity resolution, and codesign then
# fails with errSecInternalComponent. Lane certs-prep created
# approvals-signing.keychain-db and put it FIRST:
#
#   security list-keychains
#       "/Users/ejlevin1/Library/Keychains/approvals-signing.keychain-db"  <- first
#       "/Users/ejlevin1/Library/Keychains/login.keychain-db"
#       "/Library/Keychains/System.keychain"
#
# If it is not first, re-apply the order or signing will fail:
#
#   security list-keychains -d user -s \
#       ~/Library/Keychains/approvals-signing.keychain-db \
#       ~/Library/Keychains/login.keychain-db
#
# The lanes unlock it themselves (`unlock_signing_keychain` in the Fastfile);
# neither match nor gym does.
# MATCH_KEYCHAIN_NAME=approvals-signing.keychain-db
# MATCH_KEYCHAIN_PASSWORD=

# --- Optional: Apple ID fallback -------------------------------------------
# Only needed if a lane has to authenticate without the API key above; the
# Appfile reads it from here rather than committing an address.
# FASTLANE_APPLE_ID=you@example.com

# --- Optional -------------------------------------------------------------
# Set to 0 only to CREATE signing material (the one-time profile creation for
# me.ericlevin.hermesglasses). Read
# ~/Development/hermes-tool-approvals/ios/docs/BUILD_MACHINE.md first -- a
# readonly:false run against a type whose certificate is missing from the repo
# mints a new one and burns a slot.
# MATCH_READONLY=0
# Also fetch/create the development profile in `certs` (cable installs).
# MATCH_DEVELOPMENT=1
# The App Store Connect app record's numeric Apple ID, once Eric has created
# it. Optional: without it the lanes look the app up by bundle id.
# ASC_APP_ID=
# Simulator used by the `test` lane.
# HG_TEST_DEVICE=iPhone 17
